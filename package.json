{
  "name": "atlas",
  "private": true,
  "version": "0.2.0",
  "description": "Atlas: assistente pessoal com voz em português, interface holográfica, câmera e ferramentas MCP.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bridge": "node --env-file-if-exists=.env.local bridge/server.mjs",
    "bridge:writes": "node --env-file-if-exists=.env.local scripts/bridge-writes.mjs",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc -b",
    "login": "node --env-file-if-exists=.env.local scripts/codex.mjs login",
    "test": "node --test tests/*.test.mjs",
    "logout": "node --env-file-if-exists=.env.local scripts/codex.mjs logout",
    "chrome": "node --env-file-if-exists=.env.local scripts/chrome.mjs",
    "doctor": "node --env-file-if-exists=.env.local scripts/doctor.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "kokoro-js": "^1.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14",
    "@openai/codex": "0.163.0",
    "@modelcontextprotocol/sdk": "latest",
    "playwright-core": "latest"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
