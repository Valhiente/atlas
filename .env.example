# Atlas 0.2 — OpenAI Codex com conta ChatGPT; sem chave da API.
# Copie para .env.local se precisar alterar algum padrão.
# O login próprio do Atlas é feito com: npm run login

# Deixe vazio para usar o modelo padrão disponibilizado pelo Codex à sua conta.
ATLAS_MODEL=
ATLAS_BRIDGE_PORT=8787
ATLAS_HOST=127.0.0.1
ATLAS_ALLOW_WRITES=0
# ATLAS_CODEX_HOME=/caminho/absoluto/para/configuracao-codex-atlas
# ATLAS_MCP_CONFIG=/caminho/absoluto/para/mcp.json
# ATLAS_ALLOWED_ORIGINS=http://localhost:5173
# ATLAS_ALLOW_NO_ORIGIN=0
# ATLAS_FILE_ROOTS=/caminho/extra

# Navegador dedicado, aberto por npm run chrome (não exige extensão).
ATLAS_CHROME_URL=http://127.0.0.1:9222
# ATLAS_CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe

# Voz premium é opcional, separada da conta ChatGPT.
ELEVENLABS_API_KEY=
ATLAS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Nenhuma credencial deve usar prefixo VITE_.
VITE_BRIDGE_URL=ws://localhost:8787
VITE_TTS_ENGINE=system
VITE_USE_ELEVENLABS=false
# VITE_KOKORO_VOICE=bm_george
